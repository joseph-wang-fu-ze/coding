# ============================================================================
#  RGSW 实验层参数文件
#  改这个文件就能换参数，不用改 Java 代码
#
#  用法：  .\run.ps1              （按本文件跑自检）
#          .\run.ps1 scale        （额外做 N=16384 规模检查）
#          .\run.ps1 sweep        （跑参数扫描表，用来做参数优化）
#
#  优先级：系统环境变量 > 本文件 > 代码里的默认值
#  也就是说，临时试一组参数可以不改文件，直接在命令行里设：
#     $env:RGSW_BASE=256; .\run.ps1
# ============================================================================

# ---- 运行模式：test | scale | sweep ----
RGSW_MODE=test

# ---- 多项式次数 N ----
# 论文是 16384。做"跑通测试"时建议用 256~1024（快得多）。
RGSW_N=1024

# ---- 系数模数：用几个素数、每个素数多少位 ----
# 1 个 31 位素数  ≈ 2^31  （噪声上限只有 14 位，余量紧张）
# 2 个 31 位素数  ≈ 2^62  （余量百万倍级，能放得下论文的 gadget 基数）
# 注意：本实验最多支持 2 个素数（跨素数还原用的是单个 64 位整数）
# 素数由程序自动生成，且保证 NTT 友好（满足 2N | p-1），这样环乘法走 NTT 而不是 O(N^2)
RGSW_PRIMES=1
RGSW_PRIME_BITS=31

# ---- gadget 切段：基数 B 与层数 l ----
# 基数越小 → 切段数字越小 → 噪声越小，但层数越多、越慢
# 论文没给这两个值；MPC4J 的 C++ 实现用 2^16 / 7（对应 124 位模数）
RGSW_BASE=4
# 层数写 0 表示"自动"——取满足 B^l > q 的最小值（推荐）
RGSW_LEVELS=0

# ---- 噪声分布（论文未给，本实验自选）----
# noiseBits 个随机比特求和再减一半；数值越小越"干净"
RGSW_NOISE_BITS=4

# ---- 明文模数（论文值，一般不用改）----
RGSW_T=65537

# ---- 每项测试重复次数（调大更稳，调小更快）----
RGSW_TRIALS=4

# ---- scale 模式的 N ----
RGSW_SCALE_N=16384

# ---- sweep 模式的 N（扫描表用，建议小一点才快）----
RGSW_SWEEP_N=512

# ---- Java 堆上限 ----
RGSW_XMX=2g
